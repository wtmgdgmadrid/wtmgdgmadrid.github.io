---
export interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;

type TrackItem = {
  time?: string;
  duration?: string;
  speaker?: string;
  title?: string;
  type: 'talk' | 'workshop' | 'mentoria' | 'empty';
  lang?: 'en';
  rowspan?: number;
};

type AgendaRow = {
  time: string;
  isPlenary?: boolean;
  plenaryLabel?: string;
  plenaryLabelEn?: string;
  track1?: TrackItem;
  track2?: TrackItem;
  track3?: TrackItem;
};

const agenda: AgendaRow[] = [
  { time: '15:30', isPlenary: true, plenaryLabel: '📋 Registro', plenaryLabelEn: '📋 Registration' },
  { time: '16:00', isPlenary: true, plenaryLabel: '🎉 Apertura', plenaryLabelEn: '🎉 Opening' },
  {
    time: '16:10',
    track1: {
      type: 'talk',
      duration: '40 min',
      speaker: 'Arantcha Delgado',
      title: 'Más allá del pixel perfect – cuidando la experiencia desde el código frontend',
    },
    track2: { type: 'empty' },
    track3: { type: 'empty' },
  },
  {
    time: '16:55',
    track1: {
      type: 'talk',
      duration: '20 min',
      speaker: 'Victoria Clotet',
      title: 'El poder del open-source y construir en público: De Madrid a Silicon Valley',
    },
    track2: {
      type: 'workshop',
      duration: '60 min',
      rowspan: 2,
      speaker: 'Yuliia Tkachova',
      title: 'Workshop: Getting Started with Google Antigravity',
      lang: 'en',
    },
    track3: { type: 'empty' },
  },
  {
    time: '17:20',
    track1: {
      type: 'talk',
      duration: '40 min',
      speaker: 'María Rogles',
      title: '¿Design System o Disaster System? El cadáver exquisito entre diseño y desarrollo',
    },
    track2: { type: 'empty' },
    track3: { type: 'empty' },
  },
  { time: '18:00', isPlenary: true, plenaryLabel: '☕ Break', plenaryLabelEn: '☕ Break' },
  {
    time: '18:30',
    track1: {
      type: 'talk',
      duration: '20 min',
      speaker: 'Kelly Cuesta',
      title: 'Career Architecture in the AI Era: Tools, Systems & Strategic Visibility',
      lang: 'en',
    },
    track2: {
      type: 'workshop',
      duration: '60 min',
      rowspan: 5,
      speaker: 'Marisa Martín Serrano',
      title: 'Workshop: Buscar trabajo en tiempos de crisis (y de IA)',
    },
    track3: { type: 'mentoria', duration: '15 min', title: 'Mentoría Stepforward #1 · Cyntia' },
  },
  {
    time: '18:45',
    track1: { type: 'empty' },
    track2: { type: 'empty' },
    track3: { type: 'mentoria', duration: '15 min', title: 'Mentoría Stepforward #2 · Mía' },
  },
  {
    time: '18:55',
    track1: {
      type: 'talk',
      duration: '40 min',
      speaker: 'He Sun',
      title: 'Build a real-time data platform from 0 to 100 million events per day',
      lang: 'en',
    },
    track2: { type: 'empty' },
    track3: { type: 'empty' },
  },
  {
    time: '19:00',
    track1: { type: 'empty' },
    track2: { type: 'empty' },
    track3: { type: 'mentoria', duration: '15 min', title: 'Mentoría Stepforward #3 · Aurelia' },
  },
  {
    time: '19:15',
    track1: { type: 'empty' },
    track2: { type: 'empty' },
    track3: { type: 'mentoria', duration: '15 min', title: 'Mentoría Stepforward #4 · Elena' },
  },
  {
    time: '19:40',
    track1: {
      type: 'talk',
      duration: '40 min',
      speaker: 'Yoyu Li',
      title: 'Beyond the Prompt: An Anatomy of an AI-powered Game using Agent Development Kit',
      lang: 'en',
    },
    track2: { type: 'empty' },
    track3: { type: 'empty' },
  },
  { time: '20:25', isPlenary: true, plenaryLabel: '👋 Cierre', plenaryLabelEn: '👋 Closing' },
  { time: '20:30', isPlenary: true, plenaryLabel: '🤝 Networking', plenaryLabelEn: '🤝 Networking' },
];

// Pre-compute which (rowIdx, trackIdx) cells are covered by a rowspan from above
const cellsToSkip = new Set<string>();
agenda.forEach((row, rowIdx) => {
  if (row.isPlenary) return;
  [row.track1, row.track2, row.track3].forEach((track, trackIdx) => {
    if (track?.rowspan && track.rowspan > 1) {
      for (let r = rowIdx + 1; r < rowIdx + track.rowspan; r++) {
        cellsToSkip.add(`${r}-${trackIdx}`);
      }
    }
  });
});

function itemBg(type: TrackItem['type']) {
  switch (type) {
    case 'talk':
      return 'bg-[#e8f8f4] dark:bg-[#0d3d30] border-[#1ce9b6]';
    case 'workshop':
      return 'bg-[#e8f0ff] dark:bg-[#0d1f50] border-[#54A7ED]';
    case 'mentoria':
      return 'bg-[#f5e8ff] dark:bg-[#2a1040] border-[#c084fc]';
    default:
      return '';
  }
}

function itemBadge(type: TrackItem['type'], pageLang: 'es' | 'en' = 'es') {
  switch (type) {
    case 'talk':
      return { label: pageLang === 'en' ? 'Talk' : 'Charla', cls: 'bg-[#1ce9b6] text-[#0d3d30]' };
    case 'workshop':
      return { label: pageLang === 'en' ? 'Workshop' : 'Taller', cls: 'bg-[#54A7ED] text-white' };
    case 'mentoria':
      return { label: pageLang === 'en' ? 'Mentorship' : 'Mentoría', cls: 'bg-[#c084fc] text-white' };
    default:
      return null;
  }
}
---

<section
  id="agenda"
  class="py-16 md:py-24 bg-gradient-to-b from-blue-50 to-white dark:from-slate-800 dark:to-slate-900"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12 md:mb-16">
      <h2 class="text-4xl md:text-5xl font-bold mb-4 dark:text-white">Agenda</h2>
      <p class="text-lg text-gray-600 dark:text-gray-400">
        {lang === 'en' ? 'April 17, 2026 · Celonis, Madrid' : '17 de abril de 2026 · Celonis, Madrid'}
      </p>
    </div>

    <!-- Track legend -->
    <div class="flex flex-wrap justify-center gap-3 mb-8 md:mb-12">
      <span class="flex items-center gap-2 rounded-full px-4 py-1.5 bg-[#1ce9b6] text-[#0d3d30] text-sm font-semibold">
        {lang === 'en' ? '🎤 Talk · Auditorium' : '🎤 Charla · Auditorio'}
      </span>
      <span class="flex items-center gap-2 rounded-full px-4 py-1.5 bg-[#54A7ED] text-white text-sm font-semibold">
        {lang === 'en' ? '🛠️ Workshop · Workshops' : '🛠️ Taller · Talleres'}
      </span>
      <span class="flex items-center gap-2 rounded-full px-4 py-1.5 bg-[#c084fc] text-white text-sm font-semibold">
        🌱 Mentorship · Stepforward
      </span>
    </div>

    <!-- ===================== DESKTOP: table with rowspan support ===================== -->
    <div class="hidden md:block rounded-2xl shadow-lg border border-blue-100 dark:border-slate-700 overflow-hidden">
      <table class="w-full border-collapse">
        <colgroup>
          <col style="width: 100px" />
          <col />
          <col />
          <col />
        </colgroup>
        <thead>
          <tr class="bg-[#0334ab] text-white">
            <th class="px-4 py-3 text-sm font-bold text-center">{lang === 'en' ? 'Time' : 'Hora'}</th>
            <th class="px-4 py-3 text-sm font-bold text-center border-l border-white/20">
              {lang === 'en' ? '🎤 Auditorium' : '🎤 Auditorio'}
            </th>
            <th class="px-4 py-3 text-sm font-bold text-center border-l border-white/20">
              {lang === 'en' ? '🛠️ Workshops' : '🛠️ Talleres'}
            </th>
            <th class="px-4 py-3 text-sm font-bold text-center border-l border-white/20">
              {lang === 'en' ? '🌱 Mentorships' : '🌱 Mentorías'}
            </th>
          </tr>
        </thead>
        <tbody>
          {
            agenda.map((row, rowIdx) =>
              row.isPlenary ? (
                <tr>
                  <td class="px-4 py-3 text-sm font-bold text-[#0334ab] dark:text-white text-center align-middle border-t border-blue-100 dark:border-slate-700 bg-[#CAE6FF] dark:bg-[#165185]">
                    {row.time}
                  </td>
                  <td
                    colspan={row.track3 ? 2 : 3}
                    class="px-6 py-3 text-sm font-bold text-[#0334ab] dark:text-white text-center align-middle border-t border-l border-blue-200 dark:border-slate-600 bg-[#CAE6FF] dark:bg-[#165185]"
                  >
                    {lang === 'en' ? (row.plenaryLabelEn ?? row.plenaryLabel) : row.plenaryLabel}
                  </td>
                  {row.track3 && (
                    <td class="px-3 py-3 border-t border-l border-blue-200 dark:border-slate-600 bg-[#CAE6FF] dark:bg-[#165185] align-top">
                      <div class={`rounded-xl border-l-4 p-3 h-full ${itemBg(row.track3.type)}`}>
                        {itemBadge(row.track3.type, lang) && (
                          <span
                            class={`inline-block rounded-full px-2 py-0.5 text-xs font-bold mb-2 ${itemBadge(row.track3.type, lang)?.cls}`}
                          >
                            {itemBadge(row.track3.type, lang)?.label} · {row.track3.duration}
                          </span>
                        )}
                        <p class="text-xs text-gray-700 dark:text-gray-300 leading-snug">{row.track3.title}</p>
                      </div>
                    </td>
                  )}
                </tr>
              ) : (
                <tr class="bg-white dark:bg-slate-800/60">
                  <td class="px-4 py-4 text-sm font-bold text-gray-700 dark:text-gray-300 text-center align-top border-t border-blue-100 dark:border-slate-700">
                    {row.time}
                  </td>
                  {/* Track 1 */}
                  <td class="px-3 py-3 border-t border-l border-blue-100 dark:border-slate-700 align-top">
                    {row.track1 && row.track1.type !== 'empty' && (
                      <div class={`rounded-xl border-l-4 p-3 h-full ${itemBg(row.track1.type)}`}>
                        {itemBadge(row.track1.type, lang) && (
                          <span
                            class={`inline-block rounded-full px-2 py-0.5 text-xs font-bold mb-2 ${itemBadge(row.track1.type, lang)?.cls}`}
                          >
                            {itemBadge(row.track1.type, lang)?.label} · {row.track1.duration}
                          </span>
                        )}
                        {row.track1.speaker && (
                          <p class="text-xs font-bold text-gray-800 dark:text-gray-100 mb-1">{row.track1.speaker}</p>
                        )}
                        <p class="text-xs text-gray-700 dark:text-gray-300 leading-snug">{row.track1.title}</p>
                        {row.track1.lang === 'en' && (
                          <p class="text-xs italic text-gray-600 dark:text-gray-300 mt-1.5">
                            · {lang === 'en' ? 'Delivered in English' : 'Impartida en inglés'}
                          </p>
                        )}
                      </div>
                    )}
                  </td>
                  {/* Track 2 — skip if covered by a rowspan from above */}
                  {!cellsToSkip.has(`${rowIdx}-1`) && (
                    <td
                      rowspan={row.track2?.rowspan ?? 1}
                      class="px-3 py-3 border-t border-l border-blue-100 dark:border-slate-700 align-top"
                    >
                      {row.track2 && row.track2.type !== 'empty' && (
                        <div class={`rounded-xl border-l-4 p-3 h-full ${itemBg(row.track2.type)}`}>
                          {itemBadge(row.track2.type, lang) && (
                            <span
                              class={`inline-block rounded-full px-2 py-0.5 text-xs font-bold mb-2 ${itemBadge(row.track2.type, lang)?.cls}`}
                            >
                              {itemBadge(row.track2.type, lang)?.label} · {row.track2.duration}
                            </span>
                          )}
                          {row.track2.speaker && (
                            <p class="text-xs font-bold text-gray-800 dark:text-gray-100 mb-1">{row.track2.speaker}</p>
                          )}
                          <p class="text-xs text-gray-700 dark:text-gray-300 leading-snug">{row.track2.title}</p>
                          {row.track2.lang === 'en' && (
                            <p class="text-xs italic text-gray-600 dark:text-gray-300 mt-1.5">
                              · {lang === 'en' ? 'Delivered in English' : 'Impartida en inglés'}
                            </p>
                          )}
                        </div>
                      )}
                    </td>
                  )}
                  {/* Track 3 — skip if covered by a rowspan from above */}
                  {!cellsToSkip.has(`${rowIdx}-2`) && (
                    <td
                      rowspan={row.track3?.rowspan ?? 1}
                      class="px-3 py-3 border-t border-l border-blue-100 dark:border-slate-700 align-top"
                    >
                      {row.track3 && row.track3.type !== 'empty' && (
                        <div class={`rounded-xl border-l-4 p-3 h-full ${itemBg(row.track3.type)}`}>
                          {itemBadge(row.track3.type, lang) && (
                            <span
                              class={`inline-block rounded-full px-2 py-0.5 text-xs font-bold mb-2 ${itemBadge(row.track3.type, lang)?.cls}`}
                            >
                              {itemBadge(row.track3.type, lang)?.label} · {row.track3.duration}
                            </span>
                          )}
                          {row.track3.speaker && (
                            <p class="text-xs font-bold text-gray-800 dark:text-gray-100 mb-1">{row.track3.speaker}</p>
                          )}
                          <p class="text-xs text-gray-700 dark:text-gray-300 leading-snug">{row.track3.title}</p>
                          {row.track3.lang === 'en' && (
                            <p class="text-xs italic text-gray-600 dark:text-gray-300 mt-1.5">
                              · {lang === 'en' ? 'Delivered in English' : 'Impartida en inglés'}
                            </p>
                          )}
                        </div>
                      )}
                    </td>
                  )}
                </tr>
              )
            )
          }
        </tbody>
      </table>
    </div>

    <!-- ===================== MOBILE: vertical timeline ===================== -->
    <div class="md:hidden space-y-3">
      {
        agenda.map((row) =>
          row.isPlenary ? (
            <div class="flex gap-3 items-center">
              <span class="w-14 shrink-0 text-xs font-bold text-[#0334ab] dark:text-[#1ce9b6] text-right">
                {row.time}
              </span>
              <div class="flex-1 space-y-2">
                <div class="rounded-xl bg-[#CAE6FF] dark:bg-[#165185] px-4 py-2.5 text-center">
                  <p class="text-sm font-bold text-[#0334ab] dark:text-white">
                    {lang === 'en' ? (row.plenaryLabelEn ?? row.plenaryLabel) : row.plenaryLabel}
                  </p>
                </div>
                {row.track3 && (
                  <div class={`rounded-xl border-l-4 p-3 ${itemBg(row.track3.type)}`}>
                    {itemBadge(row.track3.type, lang) && (
                      <span
                        class={`inline-block rounded-full px-2 py-0.5 text-xs font-bold mb-1.5 ${itemBadge(row.track3.type, lang)?.cls}`}
                      >
                        {itemBadge(row.track3.type, lang)?.label}
                        {row.track3.duration ? ` · ${row.track3.duration}` : ''}
                      </span>
                    )}
                    <p class="text-xs text-gray-700 dark:text-gray-300 leading-snug">{row.track3.title}</p>
                  </div>
                )}
              </div>
            </div>
          ) : (
            <div class="flex gap-3">
              <span class="w-14 shrink-0 text-xs font-bold text-gray-600 dark:text-gray-400 text-right pt-3">
                {row.time}
              </span>
              <div class="flex-1 space-y-2">
                {[row.track1, row.track2, row.track3]
                  .filter((t) => t && t.type !== 'empty')
                  .map(
                    (item) =>
                      item && (
                        <div class={`rounded-xl border-l-4 p-3 ${itemBg(item.type)}`}>
                          {itemBadge(item.type, lang) && (
                            <span
                              class={`inline-block rounded-full px-2 py-0.5 text-xs font-bold mb-1.5 ${itemBadge(item.type, lang)?.cls}`}
                            >
                              {itemBadge(item.type, lang)?.label}
                              {item.duration ? ` · ${item.duration}` : ''}
                            </span>
                          )}
                          {item.speaker && (
                            <p class="text-xs font-bold text-gray-800 dark:text-gray-100 mb-0.5">{item.speaker}</p>
                          )}
                          <p class="text-xs text-gray-700 dark:text-gray-300 leading-snug">{item.title}</p>
                          {item.lang === 'en' && (
                            <p class="text-xs italic text-gray-600 dark:text-gray-300 mt-1.5">
                              · {lang === 'en' ? 'Delivered in English' : 'Impartida en inglés'}
                            </p>
                          )}
                        </div>
                      )
                  )}
              </div>
            </div>
          )
        )
      }
    </div>
  </div>
</section>
