---
import { Image } from 'astro:assets';
import arantchaImg from '~/assets/images/iwd26/speakers/Arantxa Delgado.jpg';
import victoriaImg from '~/assets/images/iwd26/speakers/Victoria Clotet.jpg';
import mariaImg from '~/assets/images/iwd26/speakers/María Rogles.jpg';
import kellyImg from '~/assets/images/iwd26/speakers/Kelly A.png';
import yoyuImg from '~/assets/images/iwd26/speakers/Yoyu Li.jpg';
import yuliiaImg from '~/assets/images/iwd26/speakers/Yuliia Tkachova.jpg';
import marisaImg from '~/assets/images/iwd26/speakers/Marisa Martin Serrano.jpg';

const speakers = [
  {
    id: 'arantcha',
    name: 'Arantcha Delgado',
    profession: 'Front-End Web Developer',
    initials: 'AD',
    color: '#1ce9b6',
    photo: arantchaImg,
    talk: 'Más allá del pixel perfect – cuidando la experiencia desde el código frontend',
    bio: 'Arantcha lleva +5 años como desarrolladora frontend con React, Vue y WordPress, creando interfaces que se usan a gusto. Fue librera, así que piensa las pantallas como páginas que se leen fácil: buena estructura, ritmo claro. En frontend se habla mucho de pixel perfect, pero poco de lo que pasa en el código para cuidar de verdad la experiencia: semántica HTML, estados de carga/error, mensajes que guían. Le hace ilusión compartir trucos prácticos y que juniors y gente con backgrounds distintos vean que su mirada suma y rompe patrones.',
  },
  {
    id: 'victoria',
    name: 'Victoria Clotet',
    profession: 'Chief Product Officer',
    initials: 'VC',
    color: '#0334ab',
    photo: victoriaImg,
    talk: 'El poder del open-source y construir en público: De Madrid a Silicon Valley',
    bio: 'Victoria Clotet es software engineer y product manager apasionada por la IA y el open source. Estudió doble grado en Computer Science y Commerce en la Universidad de Virginia (EE. UU.) y ha desarrollado proyectos combinando tecnología, diseño y producto. Ha formado parte de Founders Inc. en Silicon Valley, Google for Startups Madrid y Makers Fellowship LATAM. Actualmente es CPO en Twintual, startup de IA en España presente en Antena 3, Forbes y La Vanguardia.',
  },
  {
    id: 'maria',
    name: 'María Rogles',
    profession: 'Front-End Web Developer',
    initials: 'MR',
    color: '#54A7ED',
    photo: mariaImg,
    talk: '¿Design System o Disaster System? El cadáver exquisito entre diseño y desarrollo',
    bio: 'María es UI Developer con background en diseño. Estudió Diseño Gráfico y Multimedia y Desarrollo de Aplicaciones Web. Ha trabajado en startup, agencia de publicidad, diario digital y consultoría IT. Actualmente está en Softtek como maquetadora web en el proyecto del Real Madrid. Con 10 años en el sector, su doble perspectiva le permite entender los retos de ambos mundos. Le apasiona cuando diseño y código hablan el mismo idioma.',
  },
  {
    id: 'kelly',
    name: 'Kelly Cuesta',
    profession: 'Marketing & DEI Leader in Tech | University Lecturer | Community Founder',
    initials: 'KC',
    color: '#e040fb',
    photo: kellyImg,
    talk: 'Career Architecture in the AI Era: Tools, Systems & Strategic Visibility',
    bio: 'Kelly Cuesta es líder de marketing e inclusión (DEI) con más de una década de experiencia en empresas tecnológicas de alto crecimiento en la región EMEA. Ha liderado estrategias de go-to-market y marketing de partners en ecosistemas tecnológicos complejos, y es fundadora de Latinas in Tech Madrid y Lean In Madrid. Compagina su carrera corporativa con la docencia universitaria en branding, transformación digital y liderazgo. Kelly tiene pasión por ayudar a mujeres en tecnología a diseñar carreras intencionales, visibles y sostenibles.',
  },
  {
    id: 'hesun',
    name: 'He Sun',
    profession: 'Data & AI Leader',
    initials: 'HS',
    color: '#ff6b6b',
    talk: 'Build a real-time data platform from 0 to 100 million events per day',
    bio: 'He Sun trabaja en Data & IA en Alibaba, dando soporte a clientes globales como TikTok, Shein, AliExpress y Temu. Lleva más de 10 años en el sector construyendo sistemas de datos a gran escala que ayudan a las empresas a comprender y transformar el mundo real. Cree que el futuro de la tecnología no es solo código, sino inteligencia centrada en las personas, donde las mujeres aportan fortalezas únicas en pensamiento sistémico, empatía y resolución multidimensional de problemas.',
  },
  {
    id: 'yoyu',
    name: 'Yoyu Li',
    profession: 'Creative Technology Director',
    initials: 'YL',
    color: '#ffd600',
    photo: yoyuImg,
    talk: 'Beyond the Prompt: An Anatomy of an AI-powered Game using Agent Development Kit',
    bio: 'Yoyu Li es fundadora del estudio independiente de videojuegos Infinite Whys. Es productora y diseñadora narrativa de Whispers in the West, y escritora y diseñadora narrativa de Reigns: Three Kingdoms. Con experiencia en juegos de mesa y tecnología cloud, le apasiona introducir elementos sociales en los videojuegos a través de mecánicas de juego innovadoras.',
  },
  {
    id: 'yuliia',
    name: 'Yuliia Tkachova',
    profession: 'CEO & Co-Founder of Masthead Data',
    initials: 'YT',
    color: '#00bcd4',
    photo: yuliiaImg,
    talk: 'Getting Started with Google Antigravity',
    bio: 'Yuliia Tkachova es CEO y cofundadora de Masthead Data, una plataforma de observabilidad de datos para equipos empresariales que trabajan con Google Cloud. Con más de 8 años de experiencia en el ecosistema de Google Cloud, co-arquitectó la solución de Masthead, logrando el estatus de Partner Designado en BigQuery y MySQL, así como el reconocimiento de Google Cloud Build Partner. Referente reconocida en el sector, publica regularmente análisis estratégicos sobre soluciones de datos en Google Cloud y lideró el capítulo canadiense de la Google Cloud Customer Community. Su innovación técnica y liderazgo comunitario la han consolidado como asesora de confianza para organizaciones que escalan su infraestructura de datos en Google Cloud.',
  },
  {
    id: 'marisa',
    name: 'Marisa Martín Serrano',
    profession: 'Engineering Manager (Sol. Architect)',
    initials: 'MM',
    color: '#ff7043',
    photo: marisaImg,
    talk: 'Buscar trabajo en tiempos de crisis (y de IA)',
    bio: 'Marisa es Engineering Manager (SW Architect) con más de 15 años de experiencia en roles técnicos y no técnicos, en diversas organizaciones, sectores y países, siempre ligada a infraestructura y plataforma. Le apasiona todo lo relacionado con plataformas de negocio e ingeniería, especialmente GreenOps, FinOps, SRE y seguridad. Es mentora en Step4forward y TechShessions, adora a sus perritos y le encanta todo lo que tenga que ver con moverse y enredar.',
  },
];
---

<section
  id="ponentes"
  class="py-16 md:py-24 bg-gradient-to-b from-white to-blue-50 dark:from-slate-900 dark:to-slate-800"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12 md:mb-16">
      <h2 class="text-4xl md:text-5xl font-bold mb-4 dark:text-white">Ponentes</h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        Conoce a las increíbles mujeres que compartirán su conocimiento y experiencia
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {
        speakers.map((speaker) => (
          <article class="group flex flex-col bg-white dark:bg-slate-800 rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1 overflow-hidden">
            <div class="relative w-full aspect-[4/3] overflow-hidden bg-gray-100 dark:bg-slate-700">
              {speaker.photo ? (
                <Image
                  src={speaker.photo}
                  alt={speaker.name}
                  class="w-full h-full object-cover object-top"
                  widths={[400, 800]}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                />
              ) : (
                <div
                  class="w-full h-full flex flex-col items-center justify-center"
                  style={`background: linear-gradient(135deg, ${speaker.color}22, ${speaker.color}44);`}
                >
                  <span class="text-5xl font-bold mb-2" style={`color: ${speaker.color};`}>
                    {speaker.initials}
                  </span>
                  <span class="text-xs text-gray-500 dark:text-gray-400 italic">Foto próximamente</span>
                </div>
              )}
            </div>

            <div class="flex flex-col flex-1 p-5 sm:p-6">
              <div class="mb-3">
                <h3 class="text-lg font-bold text-gray-900 dark:text-white leading-tight mb-1">{speaker.name}</h3>
                <p class="text-xs font-medium text-primary dark:text-[#1ce9b6] leading-snug">{speaker.profession}</p>
              </div>

              <div
                class="mb-4 rounded-lg bg-blue-50 dark:bg-slate-700/60 px-3 py-2.5 border-l-4"
                style={`border-color: ${speaker.color};`}
              >
                <p class="text-xs font-semibold text-gray-700 dark:text-gray-200 leading-snug">🎤 {speaker.talk}</p>
              </div>

              <div class="flex-1">
                <div
                  id={`bio-${speaker.id}`}
                  class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed overflow-hidden transition-all duration-300"
                  style="max-height: 4.5rem;"
                >
                  {speaker.bio}
                </div>
                <button
                  id={`btn-${speaker.id}`}
                  type="button"
                  class="mt-2 text-xs font-semibold text-primary dark:text-[#1ce9b6] hover:underline focus:outline-none"
                  data-speaker-id={speaker.id}
                  data-expanded="false"
                >
                  Ver más ▾
                </button>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[id^="btn-"]').forEach((btn) => {
    const id = btn.dataset.speakerId;
    if (!id) return;
    const bioEl = document.getElementById(`bio-${id}`);
    if (!bioEl) return;

    btn.addEventListener('click', () => {
      const expanded = btn.dataset.expanded === 'true';
      if (expanded) {
        bioEl.style.maxHeight = '4.5rem';
        btn.textContent = 'Ver más ▾';
        btn.dataset.expanded = 'false';
      } else {
        bioEl.style.maxHeight = bioEl.scrollHeight + 'px';
        btn.textContent = 'Ver menos ▴';
        btn.dataset.expanded = 'true';
      }
    });
  });
</script>
