---
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';

const { member, lang = 'es' } = Astro.props;
const maxLength = 110;
const displayBio = lang === 'en' && member.bioEn ? member.bioEn : member.bio;
const bioRaw = displayBio ? displayBio.trim() : '';
let shortBio = bioRaw;
let isLong = false;
if (bioRaw.length > maxLength) {
  shortBio = bioRaw.slice(0, maxLength - 3) + '...';
  isLong = true;
}
const labelMore = lang === 'en' ? 'See more' : 'Ver más';
const labelLess = lang === 'en' ? 'See less' : 'Ver menos';
const bioId = `bio-text-${member.name.replace(/\s/g, '')}`;
const btnMoreId = `btn-more-${member.name.replace(/\s/g, '')}`;
const btnLessId = `btn-less-${member.name.replace(/\s/g, '')}`;
const pId = `bio-p-${member.name.replace(/\s/g, '')}`;
---

<article
  class="group flex flex-col h-full p-2 rounded-2xl bg-white border border-[#E4E1F3] shadow-sm dark:bg-[#28216C] dark:border-white/10 dark:shadow-none transition-shadow duration-300 hover:shadow-lg"
>
  <Image
    class="w-full h-auto aspect-[4/5] object-cover !object-top rounded-xl ring-2 ring-transparent group-hover:ring-[#DFEB9A] transition"
    width={560}
    height={700}
    widths={[200, 280, 350, 560]}
    sizes="(max-width: 639px) 90vw, (max-width: 1023px) 45vw, (max-width: 1279px) 30vw, 22vw"
    loading="lazy"
    format="webp"
    quality={85}
    {...member.image}
  />
  <div class="flex flex-col flex-1 px-3 sm:px-4 pt-4 pb-3">
    <h2 class="text-xl sm:text-2xl text-[#1C1650] dark:text-white">
      {member.name}
    </h2>
    <p id={pId} class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-[#E4E1F3]/80">
      <span id={bioId}>{shortBio}</span>
      {
        isLong && (
          <>
            <button
              id={btnMoreId}
              type="button"
              class="ml-1 underline underline-offset-2 text-sm font-medium"
              style="color: var(--aw-color-link);background:none;border:none;padding:0;cursor:pointer;"
              onclick={`
              document.getElementById('${bioId}').textContent = '${displayBio.replace(/'/g, "\\'")}';
              document.getElementById('${btnMoreId}').style.display = 'none';
              document.getElementById('${btnLessId}').style.display = 'inline';
                          `}
            >
              {labelMore}
            </button>
            <button
              id={btnLessId}
              type="button"
              class="ml-1 underline underline-offset-2 text-sm font-medium"
              style="display:none;background:none;border:none;padding:0;cursor:pointer;"
              onclick={`
              document.getElementById('${bioId}').textContent = '${shortBio.replace(/'/g, "\\'")}';
              document.getElementById('${btnLessId}').style.display = 'none';
              document.getElementById('${btnMoreId}').style.display = 'inline';
                          `}
            >
              {labelLess}
            </button>
          </>
        )
      }
    </p>
    <footer class="flex gap-2 mt-auto pt-5">
    {
      member.social.twitter && (
        <a
          href={member.social.twitter}
          target="_blank"
          rel="noopener"
          aria-label="X"
          title="X"
          class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-[#1C1650] text-white hover:bg-[#3a2fa0] dark:bg-[#DFEB9A] dark:text-[#1C1650] dark:hover:bg-white transition-colors focus-visible:outline-offset-2"
        >
          <Icon name="tabler:brand-x" class="w-5 h-5" />
        </a>
      )
    }
    {
      member.social.linkedin && (
        <a
          href={member.social.linkedin}
          target="_blank"
          rel="noopener"
          aria-label="LinkedIn"
          title="LinkedIn"
          class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-[#1C1650] text-white hover:bg-[#3a2fa0] dark:bg-[#DFEB9A] dark:text-[#1C1650] dark:hover:bg-white transition-colors focus-visible:outline-offset-2"
        >
          <Icon name="tabler:brand-linkedin" class="w-5 h-5" />
        </a>
      )
    }
    {
      member.social.bluesky && (
        <a
          href={member.social.bluesky}
          target="_blank"
          rel="noopener"
          aria-label="Bluesky"
          title="Bluesky"
          class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-[#1C1650] text-white hover:bg-[#3a2fa0] dark:bg-[#DFEB9A] dark:text-[#1C1650] dark:hover:bg-white transition-colors focus-visible:outline-offset-2"
        >
          <Icon name="tabler:brand-bluesky" class="w-5 h-5" />
        </a>
      )
    }
    </footer>
  </div>
</article>
