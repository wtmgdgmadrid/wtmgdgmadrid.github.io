const copy = lang === 'en' ? t.en : t.es;
---

<section id="mentorias" class="py-16 md:py-24 bg-gradient-to-b from-[#f5e8ff] to-white dark:from-[#1a0a2e] dark:to-slate-900">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12">
      <span class="inline-block rounded-full bg-[#c084fc] text-white text-sm font-semibold px-4 py-1.5 mb-4">
        🌱 {copy.tag}
      </span>
      <h2 class="text-4xl md:text-5xl font-bold mb-3 dark:text-white">{copy.title}</h2>
      <p class="text-lg font-semibold text-[#7c3aed] dark:text-[#c084fc]">{copy.subtitle}</p>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-md border border-[#e9d5ff] dark:border-[#4c1d95] p-8 mb-8">
      <p class="text-gray-700 dark:text-gray-300 text-base leading-relaxed mb-8">
        {copy.description}
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {
          copy.features.map((f) => (
            <div class="flex flex-col items-center text-center rounded-xl bg-[#f5e8ff] dark:bg-[#2a1040] border border-[#e9d5ff] dark:border-[#6d28d9] p-4">
              <span class="text-2xl mb-2">{f.icon}</span>
              <p class="text-sm font-bold text-gray-800 dark:text-gray-100">{f.label}</p>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">{f.detail}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-16">
      <div class="text-center mb-10">
        <h3 class="text-3xl font-bold text-gray-900 dark:text-white">{copy.verticalsTitle}</h3>
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">{copy.verticalsSubtitle}</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
        {
          copy.verticals.map((vertical) => (
            <article class="rounded-2xl border border-[#ece2ff] bg-white p-6 shadow-sm dark:border-[#3f2465] dark:bg-slate-800">
              <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-[#f2e9ff] text-lg font-semibold text-[#8b5cf6] dark:bg-[#2a1040] dark:text-[#d8b4fe]">
                {vertical.icon}
              </div>
              <h4 class="text-lg font-semibold text-gray-900 dark:text-white">{vertical.title}</h4>
              <p class="mt-3 text-sm leading-6 text-gray-600 dark:text-gray-300">{vertical.description}</p>
            </article>
          ))
        }
      </div>
    </div>

    <div class="mt-20">
      <div class="mb-10">
        <div class="text-center">
          <h3 class="text-3xl font-bold text-gray-900 dark:text-white">{copy.mentorsTitle}</h3>
          <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">{copy.mentorsSubtitle}</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          copy.mentors.map((mentor) => (
            <article class="rounded-2xl border border-[#f0e8ff] bg-[#fcf9ff] p-5 shadow-sm dark:border-[#3f2465] dark:bg-[#1d1430]">
              <div class="flex items-start gap-5">
                <Image
                  src={mentor.image}
                  alt={mentor.name}
                  class="h-24 w-24 rounded-2xl object-cover shadow-sm sm:h-28 sm:w-28"
                  widths={[160, 224, 320]}
                  sizes="(max-width: 640px) 96px, 112px"
                />
                <div>
                  <h4 class="text-xl font-semibold text-gray-900 dark:text-white">{mentor.name}</h4>
                  <p class="mt-1 inline-block rounded-md bg-[#ede9fe] px-2 py-1 text-xs font-medium text-[#7c3aed] dark:bg-[#2a1040] dark:text-[#d8b4fe]">
                    {mentor.role}
                  </p>
                  <p class="mt-4 text-sm leading-6 text-gray-600 dark:text-gray-300">{mentor.description}</p>
                  <a
                    href={mentor.linkedinUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-4 inline-flex rounded-md bg-[#f3efff] px-3 py-1.5 text-xs font-medium text-[#6d28d9] hover:bg-[#ebe2ff] dark:bg-[#2a1040] dark:text-[#d8b4fe]"
                  >
                    {copy.profileLabel}
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <div class="mt-20 rounded-[2rem] bg-gradient-to-r from-[#6d28d9] to-[#8b5cf6] px-6 py-12 text-center shadow-[0_20px_40px_rgba(124,58,237,0.22)]">
      <h3 class="text-4xl font-bold text-white">{copy.ctaTitle}</h3>
      <p class="mx-auto mt-3 max-w-2xl text-sm leading-6 text-white/85 md:text-base">{copy.ctaText}</p>
      <a
        href={copy.formUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex items-center justify-center rounded-full bg-white px-6 py-3 text-sm font-semibold text-[#6d28d9] hover:bg-[#f6f1ff]"
      >
        {copy.ctaButton}
      </a>
    </div>

  </div>
</section>
