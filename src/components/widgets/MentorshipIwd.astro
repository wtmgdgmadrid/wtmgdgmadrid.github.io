      },
    ],
    mentors: [
      {
        name: 'Elena Quidi',
        role: 'Senior Tech Lead',
        description:
          'Specialist in systems scalability and technical leadership. With more than 10 years in the industry, she guides women into leadership roles.',
        image: elena,
        linkedinUrl: 'https://www.linkedin.com/in/elena-guidi-dev/',
      },
      {
        name: 'Mia Salazar',
        role: 'Product Strategist',
        description:
          'Expert in agile methodologies and product vision. She helps founders define their value proposition and scale digital businesses.',
