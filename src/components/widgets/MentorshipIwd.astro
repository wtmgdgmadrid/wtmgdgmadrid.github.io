      {
        name: 'Elena Quidi',
        role: 'Senior Tech Lead',
        description:
          'Especialista en escalabilidad de sistemas y liderazgo técnico. Con más de 10 años en el sector, guía a mujeres en su transición a roles de liderazgo.',
        image: elena,
        linkedinUrl: 'https://www.linkedin.com/in/elena-guidi-dev/',
      },
      {
        name: 'Mia Salazar',
        role: 'Product Strategist',
        description:
          'Experta en metodologías ágiles y visión de producto. Ayuda a emprendedoras a definir su propuesta de valor y escalar sus negocios digitales.',
