---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import TeamMember from '~/components/widgets/TeamMember.astro';
import Features3 from '~/components/widgets/Features3.astro';
import ImageCarousel from '~/components/widgets/ImageCarousel.astro';
import Events from '~/components/Events.jsx';
import events from '~/data/events.json';
import Testimonios from '~/pages/testimonios.astro';

const metadata = {
  title: 'Women Techmakers Madrid',
  ignoreTitleTemplate: true,
};

const teamEntries = await getCollection('team');
const team = teamEntries.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)).map((e) => e.data);

const partnerEntries = await getCollection('partner');
const partners = partnerEntries
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .map((e) => ({ image: e.data.image, url: e.data.url }));

const sponsorEntries = await getCollection('sponsor');
const sponsors = sponsorEntries
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .map((e) => ({ image: e.data.image, url: e.data.url }));
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero image={{ src: '~/assets/images/comunidad.jpg', alt: 'Comunidad' }}>
    <Fragment slot="title">
      Comunidad de <span class="xl:inline">Women Techmakers</span>
      <span class="text-accent dark:text-white"> Madrid</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="sm:inline">
        <span class="font-semibold">Women Techmakers Madrid</span> es una comunidad dedicada a potenciar y apoyar a las mujeres
        en el ámbito tecnológico de la capital española. Nuestro objetivo es crear un ecosistema donde las mujeres sean visibles,
        tengan una comunidad sólida y acceso a recursos para crecer profesionalmente.</span
      >
    </Fragment>
  </Hero>

  <Features
    id="nosotras"
    tagline="Nosotras"
    title="Descubre nuestra comunidad"
    items={[
      {
        title: 'Visibilidad y Empoderamiento Local',
        description: 'Promovemos la presencia y el liderazgo femenino en Madrid. ',
        icon: 'tabler:square-number-1',
      },
      {
        title: 'Eventos y Networking',
        description:
          'Organizamos eventos dinámicos en Madrid, presenciales y virtuales, incluyendo charlas técnicas, talleres y sesiones de networking. Cada actividad busca generar conexiones y abrir puertas a nuevas oportunidades.',
        icon: 'tabler:square-number-2',
      },
      {
        title: 'Colaboración y Comunidad',
        description:
          'Fomentamos un ambiente colaborativo donde las mujeres pueden compartir experiencias, aprender unas de otras y crecer juntas.',
        icon: 'tabler:square-number-3',
      },
      {
        title: 'Diversidad e Inclusión',
        description:
          'Nos comprometemos a crear un espacio inclusivo que celebre la diversidad y apoye a todas las mujeres en tecnología, independientemente de su nivel de experiencia.',
        icon: 'tabler:square-number-4',
      },
    ]}
  />

  <!-- Team Members -->

  <Features3 id="team" tagline="Nuestro equipo" title="Conoce a nuestras líderes" />

  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid gap-4 sm:gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 auto-rows-fr">
      {team.map((member) => <TeamMember member={member} />)}
    </div>
  </div>

  <!-- Comunidades amigas -->

  <section id="partners" class="bg-blue-50 dark:bg-slate-800">
    <h2 class="text-3xl font-bold text-center p-6 dark:text-slate-100">Comunidades amigas</h2>
    <div class="max-w-3xl mx-auto">
      <ImageCarousel images={partners} height={300} width={300} slidesPerView={4} />
    </div>
    <div class="flex flex-wrap items-center gap-2 md:gap-1 justify-center mt-8 p-4 bg-secondary text-white">
      🚀 Si quieres colaborar con nosotras rellena este
      <a
        href="https://docs.google.com/forms/d/e/1FAIpQLSeyvwGvyQnnRXp6DTsb2y6PS76ZAvwYX-tAk1ROED48PpuwXA/viewform?usp=header"
        target="_blank"
        rel="noopener"
        class="text-base font-medium text-white hover:underline"
      >
        formulario de contacto 🚀
      </a>
    </div>
  </section>
  <!-- Sponsors -->

  <Features
    id="sponsors"
    tagline="Conviértete en patrocinador"
    title="Asóciate con Women Techmakers Madrid y apoya nuestra misión"
    items={[
      {
        title: 'Visibilidad de Marca',
        description:
          'Asocia tu marca con una causa noble y gana visibilidad entre una audiencia diversa y comprometida en el sector tecnológico de Madrid.',
        icon: 'tabler:globe',
      },
      {
        title: 'Acceso a Talento',
        description:
          'Conéctate con una red de profesionales talentosas y emergentes en tecnología, facilitando oportunidades de reclutamiento y colaboración.',
        icon: 'tabler:wand',
      },
      {
        title: 'Impacto Social Positivo',
        description:
          'Contribuye al empoderamiento de las mujeres en tecnología, promoviendo la diversidad y la inclusión en el sector tecnológico local.',
        icon: 'tabler:heart',
      },
      {
        title: 'Oportunidades de Networking',
        description:
          'Participa en eventos exclusivos que facilitan conexiones valiosas con líderes de la industria, expertos y otros patrocinadores.',
        icon: 'tabler:users',
      },
    ]}
  />

  <section id="sponsors-who" class="bg-blue-50 dark:bg-slate-800">
    <h2 class="text-3xl font-bold text-center p-6 dark:text-slate-100">¿Quiénes son nuestros patrocinadores?</h2>
    <h3 class="text-lg text-center p-6 dark:text-slate-300">
      Agradecemos profundamente el apoyo de las empresas que se han unido a nuestra misión de empoderar a las mujeres en
      tecnología. Su compromiso nos permite seguir organizando eventos de impacto, ofrecer recursos valiosos y construir
      una comunidad sólida en Madrid.
    </h3>
    <div class="max-w-3xl mx-auto">
      <ImageCarousel images={sponsors} height={200} width={200} slidesPerView={3} />
    </div>
    <div
      class="flex flex-wrap items-center gap-2 md:gap-1 justify-center bg-secondary dark:bg-secondary mt-8 p-4 text-white"
    >
      🚀 ¿Quieres ver tu logo aquí?
      <a
        href="https://docs.google.com/forms/d/e/1FAIpQLSfYl9_datjfrhqRuYpd8fDEPff77vqQehHg1dsD9AHgiG-6xA/viewform?usp=header"
        target="_blank"
        rel="noopener"
        class="text-base font-medium text-white hover:underline"
      >
        Contáctanos 🚀
      </a>
    </div>
  </section>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="Tú puedes ser nuestra próxima ponente"
    title="Comparte tu experiencia y conocimientos"
    items={[
      {
        title: 'Inspira a otras mujeres',
        description: 'Tu historia puede motivar a otras mujeres a seguir sus sueños en el mundo de la tecnología.',
      },
      {
        title: 'Desarrolla tus habilidades',
        description:
          'Hablar en público es una habilidad valiosa que puede abrirte muchas puertas en tu carrera profesional.',
      },
      {
        title: 'Amplía tu red profesional',
        description:
          'Conectarás con otras profesionales del sector, lo que puede llevar a nuevas oportunidades laborales y colaboraciones.',
      },
      {
        title: 'Contribuye a la comunidad',
        description:
          'Al compartir tus conocimientos, estarás ayudando a construir una comunidad más fuerte y diversa en tecnología.',
      },
    ]}
    image={{
      src: '~/assets/images/ponente.jpg',
      alt: 'Imagen de ponente',
    }}
  />
  <div class="flex flex-wrap items-center gap-2 md:gap-1 justify-center bg-secondary text-white mt-8 p-4">
    😎 ¡Anímate a compartir tu historia!
    <a
      href="https://docs.google.com/forms/d/e/1FAIpQLSc5G_ML-8d5ObPFxmgG6nHHcOmsZ-3OBWVoQIMHhSSDlpikow/viewform?usp=header"
      target="_blank"
      rel="noopener"
      class="text-base font-medium text-white hover:underline"
    >
      Rellena nuestro formulario de ponentes 😎
    </a>
  </div>

  <!-- Proximos Eventos ****************** -->
  <Events client:load events={events} />

  <!-- Contacto RRSS -->
  <section id="contactos">
    <Content
      title="Contacta con nosotras"
      items={[
        {
          icon: 'tabler:mail',
          title: 'Envíanos un Correo',
          description: 'Para consultas, sugerencias o simplemente para saludar, no dudes en escribirnos a:',
          action: {
            label: 'womentechmakersmadrid@gmail.com',
            href: 'mailto:womentechmakersmadrid@gmail.com',
          },
        },
        {
          icon: 'tabler:brand-linkedin',
          title: 'Conéctate en LinkedIn',
          description:
            'Mantente al tanto de nuestras últimas novedades, eventos y oportunidades, y únete a nuestra comunidad activa en:',
          action: {
            label: 'www.linkedin.com/in/wtmmadrid',
            href: 'https://www.linkedin.com/in/wtmmadrid/',
          },
        },
        {
          icon: 'tabler:brand-instagram',
          title: 'Búscanos en Instagram',
          description: 'Allí subimos nuestras mejores fotos sobre los eventos y reels chulos',
          action: {
            label: '@wtmmadrid',
            href: 'https://www.instagram.com/wtmmadrid/',
          },
        },
        {
          icon: 'tabler:brand-x',
          title: 'Síguenos en X',
          description: 'En X informamos acerca de nuestros últimos encuentros',
          action: {
            label: '@WTMMadrid',
            href: 'https://x.com/WTMMadrid',
          },
        },
      ]}
      image={{
        src: '~/assets/images/WTM-contacto.jpg',
        alt: 'Imagen de grupo de personas en un evento de WTM Madrid',
      }}
    />
  </section>
  <!-- Eventos anteriores ****************** -->
  <section id="eventos-anteriores" class="p-12">
    <h1 class="text-4xl font-bold text-center mb-8 dark:text-slate-100">Galería de eventos anteriores</h1>
    <ImageCarousel
      images={[
        {
          image: {
            src: '~/assets/images/events/ponencia.jpg',
            alt: 'Ponente dando una charla en el evento Women Techmakers Madrid',
          },
        },
        {
          image: {
            src: '~/assets/images/events/publico.jpg',
            alt: 'Público asistente escuchando una charla en Women Techmakers Madrid',
          },
        },
        {
          image: {
            src: '~/assets/images/events/acreditaciones.jpg',
            alt: 'Voluntaria preparando acreditaciones en la entrada del evento Women Techmakers Madrid',
          },
        },
        {
          image: {
            src: '~/assets/images/events/dinosaurio.jpg',
            alt: 'Animación con disfraz de dinosaurio en el evento Women Techmakers Madrid',
          },
        },
        {
          image: {
            src: '~/assets/images/events/grupo.jpg',
            alt: 'Grupo de mujeres asistentes al evento',
          },
        },
      ]}
    />
  </section>

  <!-- Feedback y Testimonios ************** -->
  <Testimonios />
</Layout>
