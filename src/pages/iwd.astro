---
import LayoutIwd from '~/layouts/LayoutIwd.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Image from '~/components/common/Image.astro';
import C4PSatus from '~/components/C4pSatus.astro';
import Brands from '~/components/widgets/Brands.astro';
import celonisLogo from '~/assets/images/sponsors/celonis.png';
import sirviendoCodigoLogo from '~/assets/images/partners/sirviendo-codigo.svg';
import esw from '~/assets/images/sponsors/esw.png';
import euroformac from '~/assets/images/sponsors/euroformac.jpg';
import nextdigital from '~/assets/images/sponsors/next-digital.png';
import playtomic from '~/assets/images/sponsors/playtomic.jpg';
import capgemini from '~/assets/images/sponsors/Capgemini_logo.svg';
import medallaOro from '~/assets/images/iwd26/medallaOro.png';
import medallaBronce from '~/assets/images/iwd26/medallaBronce.png';
import medallaPlata from '~/assets/images/iwd26/medallaPlata.png';
import codemotion from '~/assets/images/partners/codemotion.png';
import latinasInTech from '~/assets/images/partners/latinas-in-tech-madrid.png';
import empowerInTech from '~/assets/images/partners/empower-in-tech.jpg';
import mermeladaTech from '~/assets/images/partners/mermelada-tech.png';
import audiense from '~/assets/images/partners/audiense.png';
import autentia from '~/assets/images/partners/autentia.jpg';
import bq from '~/assets/images/partners/bq.png';
import codely from '~/assets/images/partners/codely.svg';
import commit from '~/assets/images/partners/commit.webp';
import gft from '~/assets/images/partners/gft.svg';
import gt from '~/assets/images/partners/GT.png';
import idealista from '~/assets/images/partners/idealista.png';
import indra from '~/assets/images/partners/indra.png';
import izertis from '~/assets/images/partners/Izertis.png';
import kairos from '~/assets/images/partners/kairos.png';
import kaleidos from '~/assets/images/partners/kaleidos.svg';
import kSchool from '~/assets/images/partners/kSchool.png';
import stickermule from '~/assets/images/partners/stickermule.png';
import openbank from '~/assets/images/partners/openbank.jpg';
import paradigma from '~/assets/images/partners/paradigma.png';
import seedtag from '~/assets/images/partners/seedtag.png';
import tecnoFor from '~/assets/images/partners/TecnoFor.png';
import womenalia from '~/assets/images/partners/womenalia.png';
import cart from '~/assets/images/partners/cart.png';
// Use the local path for the logo so the image resolver can load it (keeps original filename with spaces)

const metadata = {
  title: 'IWD 2026 - Women Techmakers Madrid',
  description: 'Día Internacional de la Mujer 2026 - Women Techmakers Madrid. Save The Date: 17 de abril de 2026',
  ignoreTitleTemplate: true,
};

const celonisData = {
  name: 'Celonis',
  googleMapsLink: 'https://maps.app.goo.gl/39ts3cc8E5rUJsy18',
  description: 'Celonis is a global leader in process mining and execution management software.',
};
---

<LayoutIwd metadata={metadata}>
  <!-- Hero Section - Save The Date -->
  <Hero>
    <Fragment slot="title">
      International Women's Day
      <br />
      <span class="text-primary dark:text-white"> 2026</span>
    </Fragment>

    <Fragment slot="subtitle">
      <div class="space-y-4">
        <p class="text-2xl md:text-3xl font-bold text-primary dark:text-blue-300 mb-6">📅 Save The Date</p>
        <p class="text-xl md:text-2xl font-semibold text-gray-800 dark:text-gray-200">
          17 de abril de 2026 📍<a
            href={celonisData.googleMapsLink}
            target="_blank"
            rel="noopener"
            class="text-black hover:underline">{celonisData.name}</a
          >
        </p>
        <p class="text-lg text-gray-700 dark:text-gray-300 mt-4">
          Únete a nosotras en esta celebración especial donde destacaremos el talento, la innovación y el liderazgo de
          las mujeres en tecnología.
        </p>
      </div>
    </Fragment>

    <!-- Background: use light/dark utilities defined in tailwind.css -->
    <div slot="bg">
      <div class="absolute inset-0 iwd-bg-light dark:iwd-bg-dark" aria-hidden="true"></div>
    </div>

    <div slot="image" class="flex flex-col justify-center items-center w-full px-4">
      <!-- Light theme: show first image -->
      <div class="block dark:hidden w-full max-w-4xl">
        <Image
          src="~/assets/images/iwd26/BlackLogoWithBCK.svg"
          alt="IWD 2026 Logo"
          class="mx-auto w-full h-auto"
          width={1024}
          height={576}
        />
      </div>
      <!-- Dark theme: show second image -->
      <div class="hidden dark:block w-full max-w-4xl">
        <Image
          src="~/assets/images/iwd26/BlueLogoWithBCK.svg"
          alt="IWD 2026 Logo (blue)"
          class="mx-auto w-full h-auto"
          width={1024}
          height={576}
        />
      </div>
      <div class="w-full max-w-4xl mx-auto mt-6 sm:mt-8 text-center">
        <div class="flex justify-center">
          <Image
            src="~/assets/images/build-with-ia-logo.png"
            alt="Built with AI - Google"
            class="h-10 sm:h-14 md:h-16 w-auto max-w-full"
            width={400}
            height={64}
          />
        </div>
      </div>
    </div>
  </Hero>

  <!-- Call for Papers Section -->
  <section id="call-for-papers" class="bg-gradient-to-b from-blue-50 to-white dark:from-slate-800 dark:to-slate-900">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <h2 class="text-4xl py-6 md:text-5xl font-bold mb-6 dark:text-white">
          Comparte tu conocimiento con nuestra comunidad
        </h2>
        <div class="max-w-3xl mx-auto space-y-6 text-lg text-gray-700 dark:text-gray-300">
          <p class="text-xl font-semibold text-primary dark:text-blue-300">🎤 ¿Sobre qué puedes hablar?</p>
          <p>
            En Women Techmakers Madrid creemos firmemente que cada mujer tiene algo valioso que aportar. Tu voz es
            importante y tu experiencia puede inspirar a otras mujeres a seguir sus sueños en tecnología.
          </p>
          <p>
            <strong class="text-primary dark:text-blue-300">No importa tu nivel de experiencia</strong> - si eres estudiante,
            recién graduada o profesional con años de trayectoria, tu perspectiva es única y merece ser escuchada.
          </p>
          <p>
            En nuestras charlas, las ponentes comparten experiencias y aprendizajes prácticos que nos dejan ideas,
            herramientas o técnicas aplicables. Piensa en lo que haces en tu día a día y cómo podría ayudar a otras
            profesionales a mejorar, ahorrar tiempo o cambiar la forma de trabajar:

            <ul class="list-inside mt-4 space-y-2 list-none">
              <li>🔧 Herramientas y tecnologías que utilizas</li>
              <li>💡 Buenas prácticas y metodologías</li>
              <li>🚀 Proyectos interesantes en los que has trabajado</li>
              <li>📈 Consejos para el desarrollo profesional y liderazgo</li>
              <li>🌐 Innovaciones y tendencias en el sector tecnológico</li>
            </ul>
          </p>
          <div class="bg-slate-100 dark:bg-slate-700 rounded-lg p-6 md:p-8 shadow-lg mt-8">
            <p class="text-2xl font-bold text-gray-800 dark:text-white mb-4">✨ ¡Anímate a ser ponente! ✨</p>
            <p class="text-lg text-gray-600 dark:text-gray-300 mt-4">
              🔒 El plazo de envío de propuestas ha finalizado. Pronto anunciaremos las ponentes seleccionadas.
            </p>
          </div>
        </div>
      </div>
    </div>
    <div class="w-full">
      <C4PSatus />
    </div>
  </section>

  <!-- Event Details Section -->
  <Content
    isReversed
    tagline="Detalles del evento"
    title='IWD 2026 - <span class="break-pattern-text inline-block"><span class="break-word-animated" style="animation-delay: 0s;">Break</span> <span class="break-word-animated" style="animation-delay: 0.2s;">the</span> <span class="break-word-animated" style="animation-delay: 0.4s;">pattern</span></span>'
    items={[
      {
        title: 'Fecha y Hora',
        description: `17 de abril de 2026 - 📍<a href="${celonisData.googleMapsLink}" target="_blank" rel="noopener" class="text-muted hover:underline">${celonisData.name}</a>`,
      },
      {
        title: 'Formato',
        description: 'Evento presencial en Madrid con charlas técnicas, networking y actividades especiales',
      },
      {
        title: 'Comunidad',
        description: 'Un espacio seguro e inclusivo donde todas las mujeres en tecnología son bienvenidas',
      },
    ]}
    image={{
      src: '~/assets/images/iwd26/Background 4.svg',
      alt: 'IWD 2026 Event Details Image',
    }}
  />

  <!-- Ponentes Section -->
  <section
    id="ponentes"
    class="py-16 md:py-24 bg-gradient-to-b from-white to-blue-50 dark:from-slate-900 dark:to-slate-800"
  >
    <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-4xl md:text-5xl font-bold mb-6 dark:text-white">Ponentes</h2>
      <p class="text-xl text-primary dark:text-blue-300 font-semibold mb-4">🎤 Próximamente</p>
      <p class="text-lg text-gray-700 dark:text-gray-300 max-w-2xl mx-auto">
        Pronto anunciaremos las increíbles mujeres que compartirán su conocimiento y experiencia con nuestra comunidad.
        ¡Mantente atenta!
      </p>
    </div>
  </section>

  <!-- Agenda Section -->
  <section
    id="agenda"
    class="py-16 md:py-24 bg-gradient-to-b from-blue-50 to-white dark:from-slate-800 dark:to-slate-900"
  >
    <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-4xl md:text-5xl font-bold mb-6 dark:text-white">Agenda</h2>
      <p class="text-xl text-primary dark:text-blue-300 font-semibold mb-4">📅 Próximamente</p>
      <p class="text-lg text-gray-700 dark:text-gray-300 max-w-2xl mx-auto">
        La agenda del evento estará disponible próximamente. Prepárate para una jornada llena de charlas técnicas,
        networking y actividades especiales.
      </p>
    </div>
  </section>

  <!-- Sponsor Section -->
  <section class="py-16 md:py-24 bg-green-700 dark:bg-blue-900 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">¿Quieres ser sponsor de IWD 2026?</h2>
      <p class="text-xl mb-8 text-blue-100">Descarga el dossier con opciones de patrocinio y beneficios.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          id="sponsor-dossier"
          href="/docs/WTM-IWD-26.pdf"
          download="WTM-IWD-26.pdf"
          type="application/pdf"
          class="inline-block px-8 py-4 bg-white text-green-700 dark:text-white dark:bg-black font-bold text-lg rounded-lg shadow-lg hover:bg-gray-100 transition-all duration-300 transform hover:scale-105"
        >
          📄 Descargar dossier
        </a>
        <a
          href="/#contactos"
          class="inline-block px-8 py-4 bg-transparent border-2 border-white text-white font-bold text-lg rounded-lg hover:bg-white hover:text-primary transition-all duration-300"
        >
          🤝 Ser sponsor
        </a>
      </div>
    </div>
  </section>

  <!-- Seccion Sponsors -->
  <section class="py-20 bg-[#CAE6FF] dark:bg-[#165185]">
    <div class="mx-auto max-w-7xl px-6">
      <!-- Título -->
      <h2 class="text-center text-2xl md:text-4xl font-bold text-gray-800 dark:text-white mb-4">Sponsors</h2>

      <div class="space-y-14">
        <!-- Sponsor principal -->
        <div
          class="relative mt-6 rounded-2xl border border-[#54A7ED] p-4
                bg-white text-center dark:border-[#54A7ED] dark:bg-white"
        >
          <span
            class="mx-auto mb-3 flex w-fit items-center gap-2 rounded-full bg-[#D1ECE3]
                     px-4 py-2 text-lg font-semibold text-[#0F7C67] lg:absolute lg:left-6 lg:top-4 lg:mb-0"
          >
            MAIN SPONSOR
            <img src={medallaOro.src} alt="Gold medal" class="h-7 w-7 shrink-0 object-contain" />
          </span>
          <div class="grid min-h-[88px] w-full place-items-center lg:min-h-[120px]">
            <img
              src={celonisLogo.src}
              alt="Celonis"
              class="block mx-auto max-h-14 w-auto max-w-[240px] object-contain md:max-h-16"
            />
          </div>
        </div>

        <!-- Sponsor Gold -->
        <div
          class="relative mt-6 rounded-2xl border border-[#54A7ED] p-4
                bg-white text-center dark:border-[#54A7ED] dark:bg-white"
        >
          <span
            class="mx-auto mb-3 flex w-fit items-center gap-2 rounded-full bg-[#D1ECE3]
                     px-4 py-2 text-lg font-semibold text-[#0F7C67] lg:absolute lg:left-6 lg:top-4 lg:mb-0"
          >
            GOLD SPONSOR
            <img src={medallaBronce.src} alt="Bronze medal" class="h-7 w-7 shrink-0 object-contain" />
          </span>
          <div class="grid min-h-[88px] w-full place-items-center lg:min-h-[120px]">
            <img
              src={nextdigital.src}
              alt="Next Digital"
              class="block mx-auto max-h-14 w-auto max-w-[240px] object-contain md:max-h-16"
            />
          </div>
        </div>

        <!-- Sponsor Silver -->
        <div
          class="relative mt-6 rounded-2xl border border-[#54A7ED] p-4
                bg-white text-center dark:border-[#54A7ED] dark:bg-white"
        >
          <span
            class="mx-auto mb-3 flex w-fit items-center gap-2 rounded-full bg-[#CAE6FF]
                     px-4 py-2 text-lg font-semibold text-[#165185] lg:absolute lg:left-6 lg:top-4 lg:mb-0"
          >
            SILVER SPONSOR
            <img src={medallaPlata.src} alt="Silver medal" class="h-7 w-7 shrink-0 object-contain" />
          </span>
          <div class="grid min-h-[88px] w-full place-items-center lg:min-h-[120px]">
            <img
              src={capgemini.src}
              alt="Capgemini"
              class="block mx-auto max-h-14 w-auto max-w-[240px] object-contain md:max-h-16"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Seccion Paternern -->
  <section class="bg-[#54A7ED] py-20 dark:bg-[#165185]">
    <div class="max-w-7xl mx-auto px-6">
      <!-- Título -->
      <div class="relative mb-16">
        <h2 class="text-center text-4xl font-bold text-gray-800 dark:text-white mb-4">Partners</h2>
        <!-- Línea decorativa -->
        <div class="absolute left-0 top-full mt-4 h-[2px] w-full bg-[#165185] dark:bg-[#54A7ED]"></div>
      </div>

      <!-- Grid de logos -->
      <div
        class="rounded-lg border border-[#2480F0]/40 bg-white py-12 px-6 md:px-10 dark:border-[#54A7ED]/40 dark:bg-white"
      >
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-x-10 gap-y-12 place-items-center">
          {
            [
              {
                src: codemotion.src,
                alt: 'Codemotion',
              },
              {
                src: latinasInTech.src,
                alt: 'Latinas in Tech Madrid',
              },
              {
                src: sirviendoCodigoLogo.src,
                alt: 'Sirviendo Codigo',
              },
              {
                src: esw.src,
                alt: 'ESW',
              },
              {
                src: euroformac.src,
                alt: 'Euroformac',
              },
              {
                src: playtomic.src,
                alt: 'Playtomic',
              },
              {
                src: empowerInTech.src,
                alt: 'Empower in Tech',
              },
              {
                src: mermeladaTech.src,
                alt: 'Mermelada Tech',
              },

              {
                src: audiense.src,
                alt: 'Audiense',
              },
              {
                src: autentia.src,
                alt: 'Autentia',
              },
              {
                src: bq.src,
                alt: 'BQ',
              },
              {
                src: codely.src,
                alt: 'Codely',
              },
              {
                src: commit.src,
                alt: 'Commit',
              },
              {
                src: gft.src,
                alt: 'GFT',
              },
              {
                src: gt.src,
                alt: 'GT',
              },
              {
                src: idealista.src,
                alt: 'Idealista',
              },
              {
                src: indra.src,
                alt: 'Indra',
              },
              {
                src: izertis.src,
                alt: 'Izertis',
              },
              {
                src: kairos.src,
                alt: 'Kairos',
              },
              {
                src: kaleidos.src,
                alt: 'Kaleidos',
              },
              {
                src: kSchool.src,
                alt: 'KSchool',
              },
              {
                src: stickermule.src,
                alt: 'Sticker Mule',
                href: 'https://www.stickermule.com/es/pegatinas-personalizadas',
                class: 'max-h-20 max-w-[220px]',
              },
              {
                src: openbank.src,
                alt: 'Openbank',
              },
              {
                src: paradigma.src,
                alt: 'Paradigma',
              },
              {
                src: seedtag.src,
                alt: 'Seedtag',
              },
              {
                src: tecnoFor.src,
                alt: 'TecnoFor',
              },
              {
                src: womenalia.src,
                alt: 'Womenalia',
              },
              {
                src: cart.src,
                alt: 'Cart',
              },
            ].map((logo) => (
              <div class="flex h-20 w-full items-center justify-center">
                {logo.href ? (
                  <a href={logo.href} target="_blank" rel="noopener noreferrer" aria-label={logo.alt}>
                    <img
                      src={logo.src}
                      alt={logo.alt}
                      class={`w-auto object-contain ${logo.class ?? 'max-h-16 max-w-[180px]'}`}
                      loading="lazy"
                    />
                  </a>
                ) : (
                  <img
                    src={logo.src}
                    alt={logo.alt}
                    class={`w-auto object-contain ${logo.class ?? 'max-h-16 max-w-[180px]'}`}
                    loading="lazy"
                  />
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</LayoutIwd>

<style>
  /* Animación del logo flotante */
  @keyframes logoFloat {
    0%,
    100% {
      transform: translateY(0) scale(1);
      filter: drop-shadow(0 0 20px rgba(59, 130, 246, 0.3));
    }
    50% {
      transform: translateY(-15px) scale(1.02);
      filter: drop-shadow(0 0 30px rgba(59, 130, 246, 0.5));
    }
  }

  .animate-logo-float {
    animation: logoFloat 4s ease-in-out infinite;
  }

  /* Animaciones para "Break the Pattern" */
  @keyframes breakWordPulse {
    0%,
    100% {
      transform: scale(1) translateY(0);
      text-shadow: 0 0 0 rgba(59, 130, 246, 0);
      color: inherit;
    }
    25% {
      transform: scale(1.05) translateY(-3px);
      text-shadow:
        0 4px 12px rgba(59, 130, 246, 0.4),
        0 0 20px rgba(59, 130, 246, 0.2);
      color: rgb(59, 130, 246);
    }
    50% {
      transform: scale(1.1) translateY(-5px);
      text-shadow:
        0 6px 20px rgba(59, 130, 246, 0.6),
        0 0 30px rgba(59, 130, 246, 0.4);
      color: rgb(37, 99, 235);
    }
    75% {
      transform: scale(1.05) translateY(-3px);
      text-shadow:
        0 4px 12px rgba(59, 130, 246, 0.4),
        0 0 20px rgba(59, 130, 246, 0.2);
      color: rgb(59, 130, 246);
    }
  }

  @keyframes breakWordGlow {
    0%,
    100% {
      text-shadow: 0 0 5px rgba(59, 130, 246, 0.3);
    }
    50% {
      text-shadow:
        0 0 20px rgba(59, 130, 246, 0.8),
        0 0 30px rgba(59, 130, 246, 0.5);
    }
  }

  .break-pattern-text {
    position: relative;
    display: inline-block;
  }

  .break-word-animated {
    display: inline-block;
    animation:
      breakWordPulse 3s ease-in-out infinite,
      breakWordGlow 2s ease-in-out infinite;
    transition: all 0.3s ease;
  }

  .break-word-animated:hover {
    transform: scale(1.15) translateY(-8px) !important;
    text-shadow:
      0 8px 25px rgba(59, 130, 246, 0.8),
      0 0 40px rgba(59, 130, 246, 0.6) !important;
  }

  /* Efecto de rotura visual alrededor del texto */
  .break-pattern-text::before {
    content: '';
    position: absolute;
    top: -5px;
    left: -10px;
    right: -10px;
    bottom: -5px;
    border: 2px solid rgba(59, 130, 246, 0.3);
    border-radius: 8px;
    opacity: 0;
    animation: borderPulse 3s ease-in-out infinite;
    pointer-events: none;
    z-index: -1;
  }

  @keyframes borderPulse {
    0%,
    100% {
      opacity: 0;
      transform: scale(1);
      box-shadow: 0 0 0 rgba(59, 130, 246, 0);
    }
    50% {
      opacity: 0.6;
      transform: scale(1.05);
      box-shadow: 0 0 30px rgba(59, 130, 246, 0.4);
    }
  }

  /* Efecto de ondas expansivas */
  .break-word-animated::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border: 2px solid rgba(59, 130, 246, 0.5);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    animation: waveExpand 2s ease-out infinite;
    pointer-events: none;
  }

  @keyframes waveExpand {
    0% {
      width: 0;
      height: 0;
      opacity: 0.8;
    }
    100% {
      width: 150px;
      height: 150px;
      opacity: 0;
    }
  }

  /* Modo dark - ajustes de color */
  .dark .break-word-animated {
    color: rgb(147, 197, 253);
  }

  .dark .break-word-animated:hover {
    color: rgb(191, 219, 254);
  }

  .dark .break-pattern-text::before {
    border-color: rgba(147, 197, 253, 0.4);
    box-shadow: 0 0 30px rgba(147, 197, 253, 0.3);
  }

  .dark .break-word-animated::after {
    border-color: rgba(147, 197, 253, 0.6);
  }
</style>
