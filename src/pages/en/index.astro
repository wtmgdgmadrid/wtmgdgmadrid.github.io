---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import TeamMember from '~/components/widgets/TeamMember.astro';
import Features3 from '~/components/widgets/Features3.astro';
import ImageCarousel from '~/components/widgets/ImageCarousel.astro';
import Events from '~/components/Events.jsx';
import events from '~/data/events.json';
import Testimonios from '~/pages/testimonios.astro';

const metadata = {
  title: 'Women Techmakers Madrid',
  ignoreTitleTemplate: true,
};

const teamEntries = await getCollection('team');
const team = teamEntries.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)).map((e) => e.data);

const partnerEntries = await getCollection('partner');
const partners = partnerEntries
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .map((e) => ({ image: e.data.image, url: e.data.url }));

const sponsorEntries = await getCollection('sponsor');
const sponsors = sponsorEntries
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .map((e) => ({ image: e.data.image, url: e.data.url }));
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero image={{ src: '~/assets/images/comunidad.jpg', alt: 'Community' }}>
    <Fragment slot="title">
      <span class="xl:inline">Women Techmakers</span>
      <span class="text-accent dark:text-white"> Madrid</span> Community
    </Fragment>

    <Fragment slot="subtitle">
      <span class="sm:inline">
        <span class="font-semibold">Women Techmakers Madrid</span> is a community dedicated to empowering and supporting
        women in the tech scene of the Spanish capital. Our goal is to create an ecosystem where women are visible, have
        a strong community, and access to resources to grow professionally.</span
      >
    </Fragment>
  </Hero>

  <Features
    id="nosotras"
    tagline="About Us"
    title="Discover our community"
    items={[
      {
        title: 'Local Visibility and Empowerment',
        description: 'We promote female presence and leadership in Madrid.',
        icon: 'tabler:square-number-1',
      },
      {
        title: 'Events and Networking',
        description:
          'We organize dynamic events in Madrid, both in-person and virtual, including tech talks, workshops and networking sessions. Each activity aims to spark connections and open doors to new opportunities.',
        icon: 'tabler:square-number-2',
      },
      {
        title: 'Collaboration and Community',
        description:
          'We foster a collaborative environment where women can share experiences, learn from each other, and grow together.',
        icon: 'tabler:square-number-3',
      },
      {
        title: 'Diversity and Inclusion',
        description:
          'We are committed to creating an inclusive space that celebrates diversity and supports all women in tech, regardless of their experience level.',
        icon: 'tabler:square-number-4',
      },
    ]}
  />

  <!-- Team Members -->

  <Features3 id="team" tagline="Our team" title="Meet our leaders" />

  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid gap-4 sm:gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 auto-rows-fr">
      {team.map((member) => <TeamMember member={member} />)}
    </div>
  </div>

  <!-- Partner communities -->

  <section id="partners" class="bg-blue-50 dark:bg-slate-800">
    <h2 class="text-3xl font-bold text-center p-6 dark:text-slate-100">Partner Communities</h2>
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <ImageCarousel images={partners} height={300} width={300} slidesPerView={4} />
    </div>
    <div class="flex flex-wrap items-center gap-2 md:gap-1 justify-center mt-8 p-4 bg-secondary text-white">
      🚀 If you want to collaborate with us, fill out this
      <a
        href="https://docs.google.com/forms/d/e/1FAIpQLSeyvwGvyQnnRXp6DTsb2y6PS76ZAvwYX-tAk1ROED48PpuwXA/viewform?usp=header"
        target="_blank"
        rel="noopener"
        class="text-base font-medium text-white hover:underline"
      >
        contact form 🚀
      </a>
    </div>
  </section>

  <!-- Sponsors -->

  <Features
    id="sponsors"
    tagline="Become a sponsor"
    title="Partner with Women Techmakers Madrid and support our mission"
    items={[
      {
        title: 'Brand Visibility',
        description:
          "Associate your brand with a noble cause and gain visibility among a diverse and engaged audience in Madrid's tech sector.",
        icon: 'tabler:globe',
      },
      {
        title: 'Access to Talent',
        description:
          'Connect with a network of talented and emerging women in tech, facilitating recruitment opportunities and collaboration.',
        icon: 'tabler:wand',
      },
      {
        title: 'Positive Social Impact',
        description:
          'Contribute to the empowerment of women in tech, promoting diversity and inclusion in the local tech sector.',
        icon: 'tabler:heart',
      },
      {
        title: 'Networking Opportunities',
        description:
          'Participate in exclusive events that facilitate valuable connections with industry leaders, experts and other sponsors.',
        icon: 'tabler:users',
      },
    ]}
  />

  <section id="sponsors-who" class="bg-blue-50 dark:bg-slate-800">
    <h2 class="text-3xl font-bold text-center p-6 dark:text-slate-100">Who are our sponsors?</h2>
    <h3 class="text-lg text-center p-6 dark:text-slate-300">
      We deeply appreciate the support of the companies that have joined our mission to empower women in tech. Their
      commitment allows us to keep organizing impactful events, offer valuable resources and build a strong community in
      Madrid.
    </h3>
    <div class="max-w-3xl mx-auto">
      <ImageCarousel images={sponsors} height={200} width={200} slidesPerView={3} />
    </div>
    <div
      class="flex flex-wrap items-center gap-2 md:gap-1 justify-center bg-secondary dark:bg-secondary mt-8 p-4 text-white"
    >
      🚀 Want to see your logo here?
      <a
        href="https://docs.google.com/forms/d/e/1FAIpQLSfYl9_datjfrhqRuYpd8fDEPff77vqQehHg1dsD9AHgiG-6xA/viewform?usp=header"
        target="_blank"
        rel="noopener"
        class="text-base font-medium text-white hover:underline"
      >
        Contact us 🚀
      </a>
    </div>
  </section>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="You could be our next speaker"
    title="Share your experience and knowledge"
    items={[
      {
        title: 'Inspire other women',
        description: 'Your story can motivate other women to pursue their dreams in the world of technology.',
      },
      {
        title: 'Develop your skills',
        description: 'Public speaking is a valuable skill that can open many doors in your professional career.',
      },
      {
        title: 'Expand your professional network',
        description:
          'You will connect with other professionals in the sector, which can lead to new job opportunities and collaborations.',
      },
      {
        title: 'Contribute to the community',
        description:
          'By sharing your knowledge, you will be helping to build a stronger and more diverse tech community.',
      },
    ]}
    image={{
      src: '~/assets/images/ponente.jpg',
      alt: 'Speaker image',
    }}
  />
  <div class="flex flex-wrap items-center gap-2 md:gap-1 justify-center bg-secondary text-white mt-8 p-4">
    😎 Go ahead and share your story!
    <a
      href="https://docs.google.com/forms/d/e/1FAIpQLSc5G_ML-8d5ObPFxmgG6nHHcOmsZ-3OBWVoQIMHhSSDlpikow/viewform?usp=header"
      target="_blank"
      rel="noopener"
      class="text-base font-medium text-white hover:underline"
    >
      Fill in our speakers form 😎
    </a>
  </div>

  <!-- Upcoming Events ****************** -->
  <Events client:load events={events} locale="en" />

  <!-- Contact RRSS -->
  <section id="contactos">
    <Content
      title="Contact us"
      items={[
        {
          icon: 'tabler:mail',
          title: 'Send us an Email',
          description: 'For inquiries, suggestions or just to say hello, feel free to write to us at:',
          action: {
            label: 'womentechmakersmadrid@gmail.com',
            href: 'mailto:womentechmakersmadrid@gmail.com',
          },
        },
        {
          icon: 'tabler:brand-linkedin',
          title: 'Connect on LinkedIn',
          description:
            'Stay up to date with our latest news, events and opportunities, and join our active community at:',
          action: {
            label: 'www.linkedin.com/in/wtmmadrid',
            href: 'https://www.linkedin.com/in/wtmmadrid/',
          },
        },
        {
          icon: 'tabler:brand-instagram',
          title: 'Find us on Instagram',
          description: 'We share our best event photos and cool reels there',
          action: {
            label: '@wtmmadrid',
            href: 'https://www.instagram.com/wtmmadrid/',
          },
        },
        {
          icon: 'tabler:brand-x',
          title: 'Follow us on X',
          description: 'On X we share updates about our latest meetups',
          action: {
            label: '@WTMMadrid',
            href: 'https://x.com/WTMMadrid',
          },
        },
      ]}
      image={{
        src: '~/assets/images/WTM-contacto.jpg',
        alt: 'Group photo from a WTM Madrid event',
      }}
    />
  </section>

  <!-- Past events gallery ****************** -->
  <section id="eventos-anteriores" class="p-12">
    <h1 class="text-4xl font-bold text-center mb-8 dark:text-slate-100">Past Events Gallery</h1>
    <ImageCarousel
      images={[
        {
          image: {
            src: '~/assets/images/events/ponencia.jpg',
            alt: 'Speaker giving a talk at a Women Techmakers Madrid event',
          },
        },
        {
          image: {
            src: '~/assets/images/events/publico.jpg',
            alt: 'Audience listening to a talk at Women Techmakers Madrid',
          },
        },
        {
          image: {
            src: '~/assets/images/events/acreditaciones.jpg',
            alt: 'Volunteer preparing credentials at the entrance of Women Techmakers Madrid',
          },
        },
        {
          image: {
            src: '~/assets/images/events/dinosaurio.jpg',
            alt: 'Dinosaur costume animation at a Women Techmakers Madrid event',
          },
        },
        {
          image: {
            src: '~/assets/images/events/grupo.jpg',
            alt: 'Group of women attendees at the event',
          },
        },
      ]}
    />
  </section>

  <!-- Feedback and Testimonials ************** -->
  <Testimonios />
</Layout>
