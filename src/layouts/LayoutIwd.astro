---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import { getHeaderData, getFooterData } from '~/navigation-iwd';

// Accept the same `metadata` prop as PageLayout so pages can pass title/description
const { metadata, lang = 'es' } = Astro.props;

const headerData = getHeaderData(lang);
const footerData = getFooterData(lang);
---

<Layout metadata={metadata}>
  <!-- IWD header (uses navigation-iwd) -->
  <Header {...headerData} isSticky showToggleTheme />

  <main class="iwd-page pt-20">
    <slot />
  </main>

  <Footer {...footerData} />
</Layout>

<style is:global>
  /* IWD theme color overrides */
  .iwd-page {
    --aw-color-primary: #1ce9b6;
    --aw-color-text-page: #000000;
  }

  /* Offset sticky header when scrolling to anchor sections */
  [id] {
    scroll-margin-top: 5rem;
  }
</style>
